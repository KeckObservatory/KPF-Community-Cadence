{
    "title": "KPF Community Cadence Target Params",
    "description": "This document defines the schema for the KPF Community Cadence Target Params",
    "type": "object",
    "properties": {
        "semid": {
            "type": "string",
            "description": "Semester ID",
            "pattern": "^([0-9]{4}[AB]_[A-Z]{1}[0-9]{3})$",
            "not_editable_by_user": true
        },
        "target_name": {
            "type": "string",
            "pattern": "^[\\-a-zA-Z0-9\\s]+$",
            "description": "Target Name"
        },
        "j_mag": {
            "type": "number",
            "description": "J Magnitude"
        },
        "g_mag": {
            "type": "number",
            "description": "G Magnitude"
        },
        "t_eff": {
            "type": "number",
            "description": "Effective Temperature"
        },
        "rotational_velocity": {
            "type": "float",
            "description": "Rotational Velocity",
            "short_description": "rot vel"
        },
        "simulcal_on": {
            "type": "boolean",
            "default": true,
            "description": "simulcal on or off",
            "short_description": "Simucal"
        },
        "nominal_exposure_time": {
            "type": "integer",
            "description": "Nominal Exposure Time (s)"
        },
        "maximum_exposure_time": {
            "type": "integer",
            "description": "Maximum Exposure Time (s)"
        },
        "num_visits_per_night": {
            "type": "integer",
            "default": 1,
            "description": "Number of visits per night",
            "short_description": "# visits per night"
        },
        "num_unique_nights_per_semester": {
            "type": "integer",
            "description": "Number of unique nights per semester",
            "short_description": "# of Nights Per Semester"
        },
        "num_internight_cadence": {
            "type": "float",
            "description": "Number of internight cadence",
            "short_description": "Minimum Inter-Night Cadence"
        },
        "num_intranight_cadence": {
            "type": "float",
            "description": "Number of intranight cadence",
            "short_description": "Minimum Intra-Night Cadence"
        },
        "num_exposures_per_visit": {
            "type": "integer",
            "description": "Number of exposures per visit",
            "short_description": "# of Exposures per Visit"
        },
        "submitted": {
            "type": ["boolean", "null"],
            "description": "Has target been submitted yet?",
            "not_editable_by_user": true
        },
        "target_feasible": {
            "type": ["boolean", "null"],
            "description": "Request Feasibility",
            "not_editable_by_user": true
        },
        "epoch": {
            "type": "string",
            "description": "Epoch"
        },
        "pm_dec": {
            "type": "number",
            "description": "Proper Motion in Dec"
        },
        "pm_ra": {
            "type": "number",
            "description": "Proper Motion in RA"
        },
        "ra": {
            "type": "string",
            "description": "Right Ascension"
        },
        "dec": {
            "type": "string",
            "description": "Declination"
        },
        "ra_deg": {
            "type": "number",
            "description": "Right Ascension in degrees"
        },
        "dec_deg": {
            "type": "number",
            "description": "Declination in degrees"
        },
        "state": {
            "type": "string",
            "description": "Tells the state of the target (editied, saved, or submitted)",
            "not_editable_by_user": true
        },
        "comment": {
            "type": "string",
            "description": "Observing Notes"
        },
        "tic_id": {
            "type": "string",
            "description": "TIC Identifier"
        },
        "gaia_id": {
            "type": "string",
            "description": "GAIA Identifier"
        },
        "rise_semester_day": {
            "type": "integer",
            "description": "Rise Date",
            "not_editable_by_user": true
        },
        "sets_semester_day": {
            "type": "integer",
            "description": "Set Date",
            "not_editable_by_user": true
        },
        "details": {
            "type": "string",
            "description": "Submittal Details",
            "not_editable_by_user": true
        },
        "status": {
            "type": "string",
            "description": "Target Status",
            "not_editable_by_user": true

        },
        "submitter": {
            "type": "string",
            "description": "Submitter",
            "not_editable_by_user": true
        },
        "total_observations_requested": {
            "type": "integer",
            "description": "Total Observations Requested"
        },
        "total_time_for_target": {
            "type": "number",
            "description": "Total Time for Target"
        },
        "total_time_for_target_hours": {
            "type": "number",
            "description": "Total Time for Target (hours)"
        }
    },
    "required": [
        "semid",
        "target_name",
        "j_mag",
        "t_eff",
        "simulcal_on",
        "nominal_exposure_time",
        "maximum_exposure_time",
        "num_internight_cadence",
        "num_exposures_per_visit",
        "num_visits_per_night",
        "num_unique_nights_per_semester"
        
    ],
    "additionalProperties": true
}