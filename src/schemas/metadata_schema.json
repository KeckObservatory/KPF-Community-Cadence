{
    "title": "KPF Metadata Params",
    "description": "This document defines the schema for the KPF Metadata Params",
    "type": "object",
    "properties": {
        "obsid": {
            "type": "string",
            "description": "Observer ID",
            "translator_mapping": "ObserverID"
        },
        "observer_name": {
            "type": "string",
            "description": "Name of the observer",
            "short_description": "Observer",
            "default": "",
            "translator_mapping": "ObserverName"
        },
        "semid": {
            "type": "string",
            "description": "Semid",
            "translator_mapping": "Semid"
        },
        "semester": {
            "type": "string",
            "description": "Semester",
            "translator_mapping": "Semester"
        },
        "progid": {
            "type": "string",
            "description": "Program ID",
            "translator_mapping": "Progid"
        },
        "tags": {
            "type": "array",
            "short_description": "Tags",
            "description": "Tags, comma separated",
            "items": {
                "description": "Tag comprised of characters other than comma",
                "type": "string",
                "pattern": "^[^,]+$"
            },
            "translator_mapping": "Tags"
        },
        "submitter": {
            "type": "string",
            "description": "Submitter",
            "translator_mapping": "Submitter"
        },
        "details": {
            "type": "string",
            "description": "Submittal Details",
            "not_editable_by_user": true
        },
        "status": {
            "type": "string",
            "description": "Target Status",
            "not_editable_by_user": true
        },
        "state": {
            "type": "string",
            "description": "Tells the state of the target (editied, saved, or submitted)",
            "short_description": "Target State",
            "not_editable_by_user": true
        },
        "last_modifification": {
            "type": "string",
            "description": "Last Modified",
            "translator_mapping": "LastModified"
        }
    },
    "required": [ ],
    "additionalProperties": true
}