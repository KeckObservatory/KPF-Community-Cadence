{
    "title": "KPF Target Params",
    "description": "This document defines the schema for the KPF Target Params",
    "type": "object",
    "properties": {
        "target_name": {
            "type": "string",
            "pattern": "^[\\-a-zA-Z0-9\\s]+$",
            "description": "Target Name",
            "short_description": "Target Name",
            "translator_mapping": "TargetName"
        },
        "gaia_id": {
            "type": "string",
            "description": "GAIA Identifier: DR3 preferred (optional). May be prefixed with DR2/3 followed by a _",
            "short_description": "GAIA ID",
            "translator_mapping": "GaiaID"
        },
        "two_mass_id": {
            "type": "string",
            "description": "Two Mass Identifier",
            "short_description": "2Mass ID",
            "translator_mapping": "twoMASSID"
        },
        "tic_id": {
            "type": "string",
            "description": "TIC Identifier (optional)",
            "short_description": "TIC Identifier"
        },
        "parallax": {
            "type": ["string", "number"],
            "description": "Parallax of the target [arcseconds]",
            "short_description": "Parallax",
            "translator_mapping": "Parallax"
        },
        "systemic_velocity": {
            "type": ["number", "string"],
            "description": "Systemic Velocity [km/s]",
            "short_description": "Sys Vel",
            "translator_mapping": "RadialVelocity"
        },
        "g_mag": {
            "type": ["number", "string"],
            "description": "G Magnitude",
            "short_description": "Gmag",
            "translator_mapping": "Gmag"
        },
        "j_mag": {
            "type": ["number", "string"],
            "description": "J Magnitude",
            "short_description": "Jmag",
            "translator_mapping": "Jmag"
        },
        "t_eff": {
            "type": "number",
            "description": "Effective Temperature [Kelvin]",
            "short_description": "Teff",
            "translator_mapping": "Teff"
        },
        "ra": {
            "type": "string",
            "description": "Right Ascension [hh:mm:ss]",
            "short_description": "RA",
            "translator_mapping": "RA"
        },
        "dec": {
            "type": "string",
            "description": "Declination [dd:mm:ss]",
            "short_description": "Dec",
            "translator_mapping": "DEC"
        },
        "ra_deg": {
            "type": "number",
            "description": "Right Ascension [degrees]"
        },
        "dec_deg": {
            "type": "number",
            "description": "Declination [degrees]"
        },
        "equinox": {
            "type": "string",
            "description": "Equinox of the coordinate system (typically 2000)",
            "short_description": "Equinox",
            "translator_mapping": "Equinox"
        },
        "pm_ra": {
            "type": ["number", "string"],
            "description": "Proper Motion in RA [miliarcseconds/year]",
            "short_description": "PM RA",
            "translator_mapping": "PMRA"
        },
        "pm_dec": {
            "type": ["number", "string"],
            "description": "Proper Motion in Dec [miliarcseconds/year]",
            "short_description": "PM Dec",
            "translator_mapping": "PMDEC"
        },
        "epoch": {
            "type": ["number", "string"],
            "description": "Epoch of the coordinate measurements [decimal year]",   
            "short_description": "Epoch",
            "default": 2000,
            "translator_mapping": "Epoch",
            "multipleOf": 0.01
        },
        "d_ra": {
            "type": "number",
            "description": "Non siderial tracking rate in RA [arcseconds / hr divided by 15]",
            "short_description": "RA Offset",
            "translator_mapping": "DRA"
        },
        "d_dec": {
            "type": "number",
            "description": "Non siderial tracking rate in Dec [arcseconds / hr]",
            "short_description": "Dec Offset",
            "translator_mapping": "DDEC"
        },
        "rise_semester_day": {
            "type": "integer",
            "description": "Rise Day of Semester",
            "not_editable_by_user": true,
            "hide_column": true
        },
        "sets_semester_day": {
            "type": "integer",
            "description": "Set Day of Semester",
            "not_editable_by_user": true,
            "hide_column": true
        },
        "catalog_comment": {
            "type": "string",
            "description": "Contain information from GAIA/SIMBAD or other sources.",
            "short_description": "Cat. Comment",
            "not_editable_by_user": true
        }
    },
    "required": [ ],
    "additionalProperties": true
}