{
    "title": "KPF Scheduleing Schema",
    "description": "This document defines the schema for the KPF Schedule",
    "type": "object",
    "properties": {
        "scheduling_mode": {
            "type": "string",
            "translator_mapping": "SchedulingMode",
            "description": "Scheduling Mode: Cadence, or Single",
            "short_description": "Scheduling Mode",
            "enum": ["Cadence", "Single"]
        },
        "desired_num_visits_per_night": {
            "type": ["integer", "string"],
            "translator_mapping": "DesiredVisitsPerNight",
            "description": "(Cadence mode) Desired Number of Visits per Night",
            "short_description": "Desired # Visits",
            "regex": "^\\d*$",
            "minimum": 1
        },
        "minimum_num_visits_per_night": {
            "type": ["integer", "string"],
            "translator_mapping": "MinVisitsPerNight",
            "description": "(Cadence mode) Minimum Number of Visits per Night",
            "short_description": "Minimum # Visits",
            "regex": "^\\d*$",
            "minimum": 1
        },
        "num_nights_per_semester": {
            "type": ["integer", "string"],
            "translator_mapping": "NightsPerSemester",
            "description": "(Cadence mode) Number of of Nights Per Semester",
            "short_description": "# Nights",
            "regex": "^\\d*$",
            "minimum": 1
        },
        "num_internight_cadence": {
            "type": ["integer", "string"],
            "translator_mapping": "interNightCadenceMin",
            "description": "(Cadence mode) Minimum Inter-Night Cadence (days) is the time difference of between consecutive observations spread over multiple nights",
            "short_description": "Internight Cadence",
            "regex": "^\\d*$"
        },
        "num_intranight_cadence": {
            "type": ["integer", "string"],
            "translator_mapping": "intraNightCadenceMin",
            "description": "(Cadence mode) Minimum Intra-Night Cadence (hours) is the frequency and timing of observations make within a single night",
            "short_description": "Intranight Cadence",
            "regex": "^\\d*$"
        },
        "fast_read_mode_requested": {
            "type": "boolean",
            "translator_mapping": "FastreadModeRequested",
            "description": "(FixedTime mode) Does this OB request Fast Read Mode?",
            "show_column": false,
            "short_description": "Fast Read Mode"
        },
        "minimum_elevation": {
            "type": ["number", "string"],
            "translator_mapping": "MinimumElevation",
            "description": "[deg] Below 30 degrees elevation, the ADC performance degrades dramatically.",
            "short_description": "Minimum Elevation",
            "format": "strNumber",
            "formatMinimum": "18",
            "formatMaximum": "85",
            "minimum": 18,
            "maximum": 85,
            "regex": "^[+]?\\d*([\\.]\\d*)?$",
            "multipleOf": 0.1
        },
        "minimum_moon_separation": {
            "type": ["number", "string"],
            "format": "strNumber",
            "translator_mapping": "MinimumMoonSeparation",
            "short_description": "Moon Separation",
            "description": "Minimum moon separation angle [deg]",
            "formatMinimum": "0",
            "regex": "^[+]?\\d*([\\.]\\d*)?$",
            "minimum": 0,
            "multipleOf": 0.1
        },
        "weather_band": {
            "type": ["integer", "string"],
            "translator_mapping": "WeatherBand",
            "description": "[bitmap] 3 bits for to bands 1, 2, and 3",
            "enum": [1, 2, 3],
            "short_description": "Weather Band",
            "not_editable_by_user": false 
        },
        "accessibility_map": {
            "type": ["number", "string"],
            "translator_mapping": "AccessibilityMap",
            "description": "[bitmap] If custom map is input, this is the AND with the default map based on inputs below",
            "short_description": "Access Map",
            "show": true,
            "not_editable_by_user": true
        },
        "total_observations_requested": {
            "type": ["integer", "string"],
            "description": "Total Observations Requested",
            "not_editable_by_user": true
        },
        "total_time_for_target": {
            "type": ["number", "string"],
            "description": "Total Time for Target [seconds]",
            "not_editable_by_user": true
        },
        "total_time_for_target_hours": {
            "type": ["number", "string"],
            "description": "Total Time for Target [hours]",
            "not_editable_by_user": true
        },
        "comment": {
            "type": "string",
            "description": "Observing Notes"
        }
    },
    "required": [ 
        "num_internight_cadence",
        "minimum_num_visits_per_night",
        "num_nights_per_semester"
    ],
    "additionalProperties": true
}