{
    "title": "KPF Scheduleing Schema",
    "description": "This document defines the schema for the KPF Schedule",
    "type": "object",
    "properties": {
        "scheduling_mode": {
            "translator_mapping": "SchedulingMode",
            "description": "FixedTime, Cadence, or Single",
            "enum": ["FixedTime", "Cadence", "Single"],
            "type": "string",
            "default": "Single"
        },
        "num_visits_per_night": {
            "translator_mapping": "VisitsPerNight",
            "description": "(Cadence mode) Number of Visits per Night",
            "type": "integer",
            "default": 1
        },
        "num_nights_per_semester": {
            "translator_mapping": "NightsPerSemester",
            "description": "(Cadence mode) Number of of Nights Per Semester",
            "type": "integer",
            "default": 1
        },
        "num_internight_cadence": {
            "translator_mapping": "interNightCadenceMin",
            "description": "(Cadence mode) Minimum Inter-Night Cadence (hours)",
            "type": "integer",
            "default": 0
        },
        "num_intranight_cadence": {
            "translator_mapping": "intraNightCadenceMin",
            "description": "(Cadence mode) Minimum Intra-Night Cadence (days)",
            "type": "number",
            "default": 1,
            "multipleOf": 0.01 
        },
        "fast_read_mode_requested": {
            "translator_mapping": "FastreadModeRequested",
            "description": "(FixedTime mode) Does this OB request Fast Read Mode?",
            "type": "boolean",
            "default": false
        },
        "fixed_time_start": {
            "translator_mapping": "FixedTimeStart",
            "description": "(FixedTime mode) Start of requested window",
            "type": "string",
            "default": ""
        },
        "fixed_time_end": {
            "translator_mapping": "FixedTimeEnd",
            "description": "(FixedTime mode) End of requested window",
            "type": "string",
            "default": ""
        },
        "weather_band": {
            "translator_mapping": "WeatherBand",
            "description": "[bitmap] 3 bits for to bands 1, 2, and 3",
            "type": "integer",
            "default": 7
        },
        "accessibility_map": {
            "translator_mapping": "AccessibilityMap",
            "description": "[bitmap] If custom map is input, this is the AND with the default map based on inputs below",
            "type": "integer",
            "default": 0
        },
        "minimum_elevation": {
            "translator_mapping": "MinimumElevation",
            "description": "[deg] Below 30 degrees elevation, the ADC performance degrades dramatically.",
            "type": "number",
            "default": 30,
            "multipleOf": 0.1
        },
        "minimum_moon_separation": {
            "translator_mapping": "MinimumMoonSeparation",
            "description": "[deg]",
            "type": "number",
            "default": 15,
            "precision": 0.1
        }
    },
    "required": [ ],
    "additionalProperties": true
}