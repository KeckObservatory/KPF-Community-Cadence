{
    "title": "KPF Observing Block",
    "description": "This document defines the schema for the KPF Observing Block",
    "type": "object",
    "properties": {
        "object": {
            "type": "string",
            "description": "Object name for the FITS header",
            "short_description": "Object",
            "default": "",
            "translator_mapping": "Object"
        },
        "num_exposures": {
            "type": "integer",
            "description": "Number of Exposures",
            "short_description": "# Exp",
            "default": 1,
            "translator_mapping": "nExp"
        },
        "exposure_time": {
            "type": "number",
            "description": "Exposure Time [seconds]",
            "short_description": "Exp Time",
            "default": 1,
            "multipleOf": 1,
            "translator_mapping": "ExpTime"
        },
        "trigger_ca_h_k": {
            "type": "boolean",
            "description": "Trigger Ca, H, and K detector for this observation?",
            "short_description": "Ca,H,&K",
            "default": true,
            "translator_mapping": "TriggerCaHK"
        },
        "trigger_green": {
            "type": "boolean",
            "description": "Trigger green detector for this observation?",
            "short_description": "Green",
            "default": true,
            "translator_mapping": "TriggerGreen"
        },
        "trigger_red": {
            "type": "boolean",
            "description": "Trigger red detector for this observation?",
            "short_description": "Red",
            "default": true,
            "translator_mapping": "TriggerRed"
        },
        "block_sky": {
            "type": "boolean",
            "description": "Block the sky fibers for the observation?",
            "short_description": "Block Sky",
            "default": false,
            "translator_mapping": "BlockSky"
        },
        "exp_meter_mode": {
            "type": "string",
            "description": "Exposure Meter Mode?",
            "short_description": "Exp Meter Mode?",
            "enum": ["monitor", "control", "off"],
            "default": "monitor",
            "translator_mapping": "ExpMeterMode"
        },
        "auto_exp_meter": {
            "type": "boolean",
            "description": "Set the exposure time on the exposure meter  automatically based on the target G magnitude?",
            "short_description": "Auto Exp Meter?",
            "default": true,
            "translator_mapping": "AutoExpMeter"
        },
        "exp_meter_exp_time": {
            "type": "number",
            "description": "Exposure Time for the exposure meter [seconds] ",
            "short_description": "Exp Meter Time",
            "default": 1,
            "multipleOf": 0.1,
            "translator_mapping": "ExpMeterExpTime"
        },
        "exp_meter_bin": {
            "type": "integer",
            "description": "Which wavelength bin to use for exposure meter termination?  (1=498nm, 2=604nm, 3=711nm, 4=817nm)",
            "short_description": "Exp Meter Bin",
            "default": 1,
            "translator_mapping": "ExpMeterBin"
        },
        "exp_meter_threshold": {
            "type": "number",
            "description": "Threshold flux at the science detector at which to terminate the exposure [e-/nm",
            "short_description": "Exp Meter Th",
            "default": 50000,
            "multipleOf": 1,
            "translator_mapping": "ExpMeterThreshold"
        },
        "take_simulcal": {
            "type": "boolean",
            "description": "Inject simultaneous calibration light on to the detector during exposure?",
            "short_description": "Simulcal",
            "default": true,
            "translator_mapping": "TakeSimulCal"
        },
        "auto_nd_filters": {
            "type": "boolean",
            "description": "Automatically set ND filters for the simultaneous calibration light?",
            "short_description": "Auto Filters",
            "default": true,
            "translator_mapping": "AutoNDFilters"
        },
        "cal_n_d_1": {
            "type": "string",
            "enum": ["OD 0.1", "OD 1.0", "OD 1.3", "OD 2.0", "OD 3.0", "OD 4.0"],
            "description": "Cal Bench filter 1 position. Throughput = 10^-OD.",
            "short_description": "Cal ND1",
            "default": "OD 0.1",
            "translator_mapping": "CalND1"
        },
        "cal_n_d_2": {
            "type": "string",
            "enum": ["OD 0.1", "OD 0.3", "OD 0.5", "OD 0.8", "OD 1.0", "OD 4.0"],
            "description": "Cal Bench filter 2 position. Throughput = 10^-OD.",
            "short_description": "Cal ND2",
            "default": "OD 0.1",
            "translator_mapping": "CalND2"
        },
        "nod_n": {
            "type": "number",
            "description": "Distance to nod the telescope North before starting exposture [arcseconds]",
            "short_description": "Nod N",
            "default": 0.0,
            "multipleOf": 0.01,
            "translator_mapping": "NodN"
        },
        "nod_e": {
            "type": "number",
            "description": "Distance to nod the telescope East before starting exposture [arcseconds]",
            "short_description": "Nod N",
            "default": 0.0,
            "multipleOf": 0.01,
            "translator_mapping": "NodE"
        },
        "guide_here": {
            "type": "boolean",
            "description": "Should the tip tilt system try to lock on to target at this position?",
            "short_description": "Guide Here",
            "default": true,
            "translator_mapping": "GuideHere"
        }
    },
    "required": [ ],
    "additionalProperties": true
}