{
    "title": "KPF Calibration Params",
    "description": "This document defines the schema for the KPF Calibration Params",
    "type": "object",
    "properties": {
        "cal_source": {
            "type": "string",
            "description": "Name of the calibration source",
            "short_description": "Calibration Source",
            "default": "EtalonFiber",
            "translator_mapping": "CalSource"
        },
        "object": {
            "type": "string",
            "description": "Name of the object",
            "short_description": "Object",
            "default": "",
            "translator_mapping": "Object"
        },
        "num_exposures": {
            "type": "integer",
            "description": "Number of Exposures",
            "short_description": "# Exposures",
            "default": 1,
            "translator_mapping": "nExp"
        },
        "exposure_time": {
            "type": "number",
            "description": "Exposure Time [seconds]",
            "short_description": "Exposure Time",
            "default": 0,
            "multipleOf": 1,
            "translator_mapping": "ExpTime"
        },
        "trigger_ca_h_k": {
            "type": "boolean",
            "description": "Trigger Ca, H, and K detector for this observation?",
            "short_description": "Trigger Ca,H,&K",
            "default": true,
            "translator_mapping": "TriggerCaHK"
        },
        "trigger_green": {
            "type": "boolean",
            "description": "Trigger green detector for this observation?",
            "short_description": "Trigger Green",
            "default": true,
            "translator_mapping": "TriggerGreen"
        },
        "trigger_red": {
            "type": "boolean",
            "description": "Trigger red detector for this observation?",
            "short_description": "Trigger red",
            "default": true,
            "translator_mapping": "TriggerRed"
        },
        "intensity_monitor": {
            "type": "boolean",
            "description": "Run an Intensity Monitor measurement on this lamp before taking data?",
            "short_description": "Intensity Monitor?",
            "default": false,
            "translator_mapping": "IntensityMonitor"
        },
        "cal_n_d_1": {
            "type": "string",
            "enum": ["OD 0.1", "OD 1.0", "OD 1.3", "OD 2.0", "OD 3.0", "OD 4.0"],
            "description": "Cal Bench filter 1 position. Throughput = 10^-OD.",
            "short_description": "Cal ND1",
            "default": "OD 0.1",
            "translator_mapping": "CalND1"
        },
        "cal_n_d_2": {
            "type": "string",
            "enum": ["OD 0.1", "OD 0.3", "OD 0.5", "OD 0.8", "OD 1.0", "OD 4.0"],
            "description": "Cal Bench filter 2 position. Throughput = 10^-OD.",
            "short_description": "Cal ND2",
            "default": "OD 0.1",
            "translator_mapping": "CalND2"
        },
        "open_science_shutter": {
            "type": "boolean",
            "description": "Open the science shutter for science fiber?",
            "short_description": "Open sky shutter?",
            "default": true,
            "translator_mapping": "OpenScienceShutter"
        },
        "open_sky_shutter": {
            "type": "boolean",
            "description": "Open the sky shutter for science fiber?",
            "short_description": "Open sky shutter?",
            "default": true,
            "translator_mapping": "OpenSkyShutter"
        },
        "take_simulcal": {
            "type": "boolean",
            "description": "Inject simultaneous calibration light on to the detector during exposure?",
            "short_description": "Take Simulcal?",
            "default": true,
            "translator_mapping": "TakeSimulCal"
        },
        "wide_flat_pos": {
            "type": "string",
            "description": "If the WideFlat source is chosen, which wheel position to use?",
            "short_description": "Wide Flat Position",
            "default": "",
            "translator_mapping": "WideFlatPos"
        },
        "exp_meter_mode": {
            "type": "string",
            "description": "Exposure Meter Mode?",
            "short_description": "Exposure Meter Mode?",
            "enum": ["monitor", "control", "off"],
            "default": "off",
            "translator_mapping": "ExpMeterMode"
        },
        "exp_meter_exp_time": {
            "type": "number",
            "description": "Exposure Time for the exposure meter [seconds] ",
            "short_description": "Exposure Meter Exposure Time",
            "default": 1,
            "multipleOf": 0.1,
            "translator_mapping": "ExpMeterExpTime"
        },
        "exp_meter_bin": {
            "type": "integer",
            "description": "Which wavelength bin to use for exposure meter termination?  (1=498nm, 2=604nm, 3=711nm, 4=817nm)",
            "short_description": "Exposure Meter Bin",
            "default": 1,
            "translator_mapping": "ExpMeterBin"
        },
        "exp_meter_threshold": {
            "type": "number",
            "description": "Threshold flux at the science detector at which to terminate the exposure [e-/nm",
            "short_description": "Exposure Meter Threshold",
            "default": 50000,
            "multipleOf": 1,
            "translator_mapping": "ExpMeterThreshold"
        }
    },
    "required": [ ],
    "additionalProperties": true
}